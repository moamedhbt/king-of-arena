    "test": "tsx tests/run.ts",
    "test:puzzles": "tsx tests/puzzles.test.ts",
    "test:sim": "tsx tests/sim.test.ts",
    "test:fairness": "tsx tests/fairness.test.ts",
    "bots": "tsx tests/bots-match.ts",
    "test:items": "tsx tests/items.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
